{% doc %}
  @prompt
    A magazine-style editorial layout, only four slorts
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-editorial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-editorial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-editorial-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-card-content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-editorial-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
  }

  .ai-editorial-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-card-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-editorial-card-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'article_image_' | append: i
        assign category_key = 'article_category_' | append: i
        assign title_key = 'article_title_' | append: i
        assign excerpt_key = 'article_excerpt_' | append: i
        assign author_key = 'article_author_' | append: i
        assign date_key = 'article_date_' | append: i

        assign image = block.settings[image_key]
        assign category = block.settings[category_key]
        assign title = block.settings[title_key]
        assign excerpt = block.settings[excerpt_key]
        assign author = block.settings[author_key]
        assign date = block.settings[date_key]
      %}
      <article class="ai-editorial-card-{{ ai_gen_id }}">
        {% if image %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-editorial-card-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-editorial-card-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        <div class="ai-editorial-card-content-{{ ai_gen_id }}">
          {% if category != blank %}
            <div class="ai-editorial-card-category-{{ ai_gen_id }}">{{ category }}</div>
          {% endif %}
          {% if title != blank %}
            <h3 class="ai-editorial-card-title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}
          {% if excerpt != blank %}
            <p class="ai-editorial-card-excerpt-{{ ai_gen_id }}">{{ excerpt }}</p>
          {% endif %}
          {% if author != blank or date != blank %}
            <div class="ai-editorial-card-meta-{{ ai_gen_id }}">
              {% if author != blank %}
                {{ author }}
              {% endif %}
              {% if author != blank and date != blank %}
                •
              {% endif %}
              {% if date != blank %}
                {{ date }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

