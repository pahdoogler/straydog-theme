{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-editorial-hero-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-editorial-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 500px;
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 500px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    color: {{ block.settings.hero_text_color }};
  }

  .ai-editorial-hero-category-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
  }

  .ai-editorial-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 700;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .ai-editorial-hero-excerpt-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 16px 0;
    opacity: 0.9;
  }

  .ai-editorial-hero-meta-{{ ai_gen_id }} {
    font-size: 14px;
    opacity: 0.8;
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-editorial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-editorial-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-card-content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-editorial-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
  }

  .ai-editorial-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-card-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-editorial-card-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-editorial-secondary-{{ ai_gen_id }} {
    grid-column: span 12;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-small-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-editorial-small-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-editorial-small-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-small-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 180px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-small-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-small-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-editorial-small-card-category-{{ ai_gen_id }} {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    color: {{ block.settings.category_color }};
    font-weight: 600;
  }

  .ai-editorial-small-card-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-small-card-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-hero-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
      flex-direction: row;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} .ai-editorial-card-{{ ai_gen_id }} {
      flex: 1;
    }

    .ai-editorial-secondary-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-editorial-secondary-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-editorial-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.7 }}px;
    }

    .ai-editorial-hero-overlay-{{ ai_gen_id }} {
      padding: 24px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <article class="ai-editorial-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          class="ai-editorial-hero-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
        >
      {% else %}
        <div class="ai-editorial-hero-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-editorial-hero-overlay-{{ ai_gen_id }}">
        {% if block.settings.hero_category != blank %}
          <div class="ai-editorial-hero-category-{{ ai_gen_id }}">{{ block.settings.hero_category }}</div>
        {% endif %}
        {% if block.settings.hero_title != blank %}
          <h2 class="ai-editorial-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h2>
        {% endif %}
        {% if block.settings.hero_excerpt != blank %}
          <p class="ai-editorial-hero-excerpt-{{ ai_gen_id }}">{{ block.settings.hero_excerpt }}</p>
        {% endif %}
        {% if block.settings.hero_author != blank or block.settings.hero_date != blank %}
          <div class="ai-editorial-hero-meta-{{ ai_gen_id }}">
            {% if block.settings.hero_author != blank %}
              {{ block.settings.hero_author }}
            {% endif %}
            {% if block.settings.hero_author != blank and block.settings.hero_date != blank %}
              •
            {% endif %}
            {% if block.settings.hero_date != blank %}
              {{ block.settings.hero_date }}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </article>

    <aside class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign image_key = 'sidebar_image_' | append: i
          assign category_key = 'sidebar_category_' | append: i
          assign title_key = 'sidebar_title_' | append: i
          assign excerpt_key = 'sidebar_excerpt_' | append: i
          assign author_key = 'sidebar_author_' | append: i
          assign date_key = 'sidebar_date_' | append: i

          assign image = block.settings[image_key]
          assign category = block.settings[category_key]
          assign title = block.settings[title_key]
          assign excerpt = block.settings[excerpt_key]
          assign author = block.settings[author_key]
          assign date = block.settings[date_key]
        %}
        <article class="ai-editorial-card-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              class="ai-editorial-card-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-editorial-card-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-editorial-card-content-{{ ai_gen_id }}">
            {% if category != blank %}
              <div class="ai-editorial-card-category-{{ ai_gen_id }}">{{ category }}</div>
            {% endif %}
            {% if title != blank %}
              <h3 class="ai-editorial-card-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if excerpt != blank %}
              <p class="ai-editorial-card-excerpt-{{ ai_gen_id }}">{{ excerpt }}</p>
            {% endif %}
            {% if author != blank or date != blank %}
              <div class="ai-editorial-card-meta-{{ ai_gen_id }}">
                {% if author != blank %}
                  {{ author }}
                {% endif %}
                {% if author != blank and date != blank %}
                  •
                {% endif %}
                {% if date != blank %}
                  {{ date }}
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </aside>

    <div class="ai-editorial-secondary-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'secondary_image_' | append: i
          assign category_key = 'secondary_category_' | append: i
          assign title_key = 'secondary_title_' | append: i
          assign author_key = 'secondary_author_' | append: i
          assign date_key = 'secondary_date_' | append: i

          assign image = block.settings[image_key]
          assign category = block.settings[category_key]
          assign title = block.settings[title_key]
          assign author = block.settings[author_key]
          assign date = block.settings[date_key]
        %}
        <article class="ai-editorial-small-card-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 500 }}"
              alt="{{ image.alt | escape }}"
              class="ai-editorial-small-card-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-editorial-small-card-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-editorial-small-card-content-{{ ai_gen_id }}">
            {% if category != blank %}
              <div class="ai-editorial-small-card-category-{{ ai_gen_id }}">{{ category }}</div>
            {% endif %}
            {% if title != blank %}
              <h3 class="ai-editorial-small-card-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            {% if author != blank or date != blank %}
              <div class="ai-editorial-small-card-meta-{{ ai_gen_id }}">
                {% if author != blank %}
                  {{ author }}
                {% endif %}
                {% if author != blank and date != blank %}
                  •
                {% endif %}
                {% if date != blank %}
                  {{ date }}
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

