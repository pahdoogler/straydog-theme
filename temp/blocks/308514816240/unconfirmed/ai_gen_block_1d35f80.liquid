      "label": "Title",
      "default": "Feature two"
    },
    {
      "type": "richtext",
      "id": "item_2_text",
      "label": "Text",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Title",
      "default": "Feature three"
    },
    {
      "type": "richtext",
      "id": "item_3_text",
      "label": "Text",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "header",
      "content": "Item 4"
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Title",
      "default": "Feature four"
    },
    {
      "type": "richtext",
      "id": "item_4_text",
      "label": "Text",
      "default": "<p>Add your description here</p>"
    }
  ],
  "presets": [
    {
      "name": "Four block grid"
    }
  ]
}
{% endschema %}
