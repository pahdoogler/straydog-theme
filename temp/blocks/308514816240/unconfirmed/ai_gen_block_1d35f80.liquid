{% doc %}
  @prompt
    four blocks two by two
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-grid-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.item_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    text-align: {{ block.settings.text_alignment }};
    min-height: {{ block.settings.min_height }}px;
    justify-content: center;
  }

  .ai-grid-item-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-grid-item-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-grid-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-wrapper-{{ ai_gen_id }}">
    <div class="ai-grid-item-{{ ai_gen_id }}">
      {% if block.settings.item_1_title != blank %}
        <h3 class="ai-grid-item-title-{{ ai_gen_id }}">{{ block.settings.item_1_title }}</h3>
      {% endif %}
      {% if block.settings.item_1_text != blank %}
        <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.item_1_text }}</div>
      {% endif %}
    </div>

    <div class="ai-grid-item-{{ ai_gen_id }}">
      {% if block.settings.item_2_title != blank %}
        <h3 class="ai-grid-item-title-{{ ai_gen_id }}">{{ block.settings.item_2_title }}</h3>
      {% endif %}
      {% if block.settings.item_2_text != blank %}
        <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.item_2_text }}</div>
      {% endif %}
    </div>

    <div class="ai-grid-item-{{ ai_gen_id }}">
      {% if block.settings.item_3_title != blank %}
        <h3 class="ai-grid-item-title-{{ ai_gen_id }}">{{ block.settings.item_3_title }}</h3>
      {% endif %}
      {% if block.settings.item_3_text != blank %}
        <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.item_3_text }}</div>
      {% endif %}
    </div>

    <div class="ai-grid-item-{{ ai_gen_id }}">
      {% if block.settings.item_4_title != blank %}
        <h3 class="ai-grid-item-title-{{ ai_gen_id }}">{{ block.settings.item_4_title }}</h3>
      {% endif %}
      {% if block.settings.item_4_text != blank %}
        <div class="ai-grid-item-text-{{ ai_gen_id }}">{{ block.settings.item_4_text }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Four block grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Item style"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 100,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "item_background",
      "label": "Item background",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Title",
      "default": "Feature one"
    },
    {
      "type": "richtext",
      "id": "item_1_text",
      "label": "Text",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "text",
