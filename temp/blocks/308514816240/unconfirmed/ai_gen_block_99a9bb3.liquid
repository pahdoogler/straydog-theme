{% doc %}
  @prompt
    four blocks
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-blocks-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-blocks-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-four-blocks-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.block_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.block_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    transition: transform 0.3s ease;
  }

  .ai-four-blocks-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-four-blocks-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-blocks-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-four-blocks-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-four-blocks-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-four-blocks-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 600;
  }

  .ai-four-blocks-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-four-blocks-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-blocks-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<four-blocks-{{ ai_gen_id }} class="ai-four-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-blocks-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'block_' | append: i | append: '_icon'
        assign title_key = 'block_' | append: i | append: '_title'
        assign text_key = 'block_' | append: i | append: '_text'
        
        assign icon = block.settings[icon_key]
        assign title = block.settings[title_key]
        assign text = block.settings[text_key]
      %}
      
      <div class="ai-four-blocks-item-{{ ai_gen_id }}">
        <div class="ai-four-blocks-icon-{{ ai_gen_id }}">
          {% if icon %}
            <img
              src="{{ icon | image_url: width: 200 }}"
              alt="{{ title | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-four-blocks-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        {% if title != blank %}
          <h3 class="ai-four-blocks-title-{{ ai_gen_id }}">{{ title }}</h3>
        {% endif %}
        
        {% if text != blank %}
          <div class="ai-four-blocks-text-{{ ai_gen_id }}">{{ text }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</four-blocks-{{ ai_gen_id }}>

<script>
  (function() {
    class FourBlocks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('four-blocks-{{ ai_gen_id }}', FourBlocks{{ ai_gen_id }});
  })();
</script>

